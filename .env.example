FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///ag_cms.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ag_cms

# OpenAI API (optional - AI features degrade gracefully without it)
OPENAI_API_KEY=your-openai-api-key-here

# Session & Security
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Church Settings
CHURCH_NAME=Grace Community Church
CHURCH_ADDRESS=123 Faith Avenue, City, Country
CHURCH_PHONE=+1-555-0100
CHURCH_EMAIL=info@gracechurch.org

# File Upload
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
